# Token da API Olho Vivo (SPTrans).
# Cadastro gratuito em: https://www.sptrans.com.br/desenvolvedores/
# Copie este arquivo para ".env" e preencha.
SPTRANS_TOKEN=cole_seu_token_aqui

# MongoDB (opcional, mas é o store geoespacial do projeto).
# Local:      mongodb://localhost:27017
# Atlas:      mongodb+srv://usuario:senha@cluster.xxxxx.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB=olhovivo
